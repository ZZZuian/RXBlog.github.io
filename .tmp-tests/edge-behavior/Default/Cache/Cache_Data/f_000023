<script>
(function() {
    var body = document.body;
    var themeButton = document.getElementById('themeToggle');
    var savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        body.classList.add('dark');
    }
    themeButton.addEventListener('click', function() {
        body.classList.toggle('dark');
        localStorage.setItem('theme', body.classList.contains('dark') ? 'dark' : 'light');
    });

    var sidebar = document.getElementById('siteSidebar');
    var openButton = document.getElementById('sidebarOpen');
    var closeButton = document.getElementById('sidebarClose');
    var backdrop = document.getElementById('sidebarBackdrop');
    function setSidebar(open) {
        sidebar.classList.toggle('open', open);
        backdrop.hidden = !open;
        openButton.setAttribute('aria-expanded', open ? 'true' : 'false');
        body.classList.toggle('nav-open', open);
    }
    openButton.addEventListener('click', function() { setSidebar(true); });
    closeButton.addEventListener('click', function() { setSidebar(false); });
    backdrop.addEventListener('click', function() { setSidebar(false); });
    document.addEventListener('keydown', function(event) { if (event.key === 'Escape') setSidebar(false); });

    var csrfToken = document.querySelector('meta[name="csrf-token"]').content;
    var confirmDialog = document.getElementById('appConfirmDialog');
    var pendingConfirmForm = null;
    var pendingConfirmSubmitter = null;
    var confirmReturnFocus = null;

    function closeAppConfirm() {
        if (!confirmDialog || confirmDialog.hidden) return;
        confirmDialog.hidden = true;
        body.classList.remove('confirm-dialog-open');
        pendingConfirmForm = null;
        pendingConfirmSubmitter = null;
        if (confirmReturnFocus && document.contains(confirmReturnFocus)) {
            confirmReturnFocus.focus();
        }
        confirmReturnFocus = null;
    }

    document.addEventListener('submit', function(event) {
        var form = event.target.closest('form[data-confirm-message]');
        if (!form || form.dataset.confirmed === 'true') {
            if (form) delete form.dataset.confirmed;
            return;
        }
        event.preventDefault();
        pendingConfirmForm = form;
        pendingConfirmSubmitter = event.submitter || null;
        confirmReturnFocus = pendingConfirmSubmitter || document.activeElement;
        confirmDialog.querySelector('#appConfirmTitle').textContent =
            form.dataset.confirmTitle || '确认操作？';
        confirmDialog.querySelector('#appConfirmMessage').textContent =
            form.dataset.confirmMessage;
        var confirmButton = confirmDialog.querySelector('[data-confirm-submit]');
        confirmButton.textContent = form.dataset.confirmButton || '确认';
        confirmDialog.hidden = false;
        body.classList.add('confirm-dialog-open');
        confirmButton.focus();
    });

    confirmDialog.addEventListener('click', function(event) {
        if (event.target.closest('[data-confirm-cancel]')) {
            closeAppConfirm();
            return;
        }
        if (!event.target.closest('[data-confirm-submit]') ||
                !pendingConfirmForm) return;
        var form = pendingConfirmForm;
        var submitter = pendingConfirmSubmitter;
        confirmDialog.hidden = true;
        body.classList.remove('confirm-dialog-open');
        pendingConfirmForm = null;
        pendingConfirmSubmitter = null;
        confirmReturnFocus = null;
        form.dataset.confirmed = 'true';
        if (submitter && form.contains(submitter)) form.requestSubmit(submitter);
        else form.requestSubmit();
    });

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && confirmDialog && !confirmDialog.hidden) {
            event.preventDefault();
            closeAppConfirm();
        }
    });
    document.addEventListener('click', function(event) {
        var button = event.target.closest('.js-post-like');
        if (!button || button.disabled) return;
        var liked = button.dataset.liked === 'true';
        button.disabled = true;
        fetch(button.dataset.likeUrl, {
            method: 'POST',
            headers: {'Content-Type': 'application/json', 'X-CSRFToken': csrfToken},
            body: JSON.stringify({action: liked ? 'unlike' : 'like'})
        }).then(function(response) {
            if (!response.ok) throw new Error('like request failed');
            return response.json();
        }).then(function(data) {
            button.dataset.liked = data.liked ? 'true' : 'false';
            button.classList.toggle('liked', data.liked);
            button.setAttribute('aria-pressed', data.liked ? 'true' : 'false');
            button.setAttribute('aria-label', data.liked ? '取消点赞' : '点赞');
            button.querySelector('.like-glyph').textContent = data.liked ? '♥' : '♡';
            button.querySelector('.like-count').textContent = data.likes;
        }).catch(function() {
            button.classList.add('like-error');
            window.setTimeout(function() { button.classList.remove('like-error'); }, 900);
        }).finally(function() { button.disabled = false; });
    });

    document.addEventListener('submit', function(event) {
        var form = event.target;
        if (!form.matches('.js-comment-form')) return;
        event.preventDefault();
        var textarea = form.querySelector('[name="content"]');
        var submit = form.querySelector('[type="submit"]');
        var status = form.querySelector('.comment-submit-status');
        var content = textarea.value.trim();
        if (!content) {
            status.textContent = '请输入评论内容。';
            return;
        }
        submit.disabled = true;
        status.textContent = '正在发表…';
        fetch(form.dataset.apiUrl, {
            method: 'POST',
            headers: {'Content-Type': 'application/json',
                      'X-CSRFToken': csrfToken},
            body: JSON.stringify({content: content})
        }).then(function(response) {
            return response.json().then(function(payload) {
                if (!response.ok) throw new Error(payload.error || '评论发表失败。');
                return payload;
            });
        }).then(function(data) {
            var comment = data.comment;
            var item = document.createElement('div');
            item.className = 'comment-item';
            item.id = 'comment-' + comment.id;

            var header = document.createElement('div');
            header.className = 'comment-header';
            var avatarBox = document.createElement('div');
            avatarBox.className = 'comment-avatar-container';
            var avatar = document.createElement('img');
            avatar.className = 'comment-avatar';
            avatar.src = comment.avatar_url;
            avatar.alt = comment.nickname;
            avatarBox.appendChild(avatar);

            var meta = document.createElement('div');
            meta.className = 'comment-meta';
            var author = document.createElement('a');
            author.className = 'comment-author-link comment-nickname';
            author.href = comment.profile_url;
            author.textContent = comment.nickname;
            var createdAt = document.createElement('span');
            createdAt.className = 'comment-time';
            createdAt.textContent = comment.created_at;
            meta.appendChild(author);
            meta.appendChild(createdAt);

            var body = document.createElement('div');
            body.className = 'comment-body';
            body.textContent = comment.content;
            header.appendChild(avatarBox);
            header.appendChild(meta);
            item.appendChild(header);
            item.appendChild(body);
            document.getElementById('commentList').appendChild(item);

            var counter = document.getElementById('commentCount');
            counter.dataset.count = data.count;
            counter.textContent = '评论 (' + data.count + ')';
            textarea.value = '';
            status.textContent = '评论已发表。';
        }).catch(function(error) {
            status.textContent = error.message || '评论发表失败，请重试。';
        }).finally(function() { submit.disabled = false; });
    });

    var audio = document.getElementById('bgMusic');
    var player = document.getElementById('musicPlayer');
    var toggle = document.getElementById('musicToggle');
    var previous = document.getElementById('musicPrev');
    var next = document.getElementById('musicNext');
    var progress = document.getElementById('musicProgress');
    var volume = document.getElementById('musicVolume');
    var title = document.getElementById('musicTitle');
    var time = document.getElementById('musicTime');
    var disc = document.querySelector('.music-disc');
    var defaultTrack = {
        id: 'default-bgm', key: 'default-bgm', title: '默认bgm', artist: '',
        cover: "/static/images/default-bgm-cover.png",
        duration: 0,
        audio: "/static/music/bgm.mp3"
    };
    var playlist = [defaultTrack];
    var playlistSource = 'default';
    var currentIndex = 0;
    var pendingTime = 0;
    var failedTracks = 0;
    var savedVolume = localStorage.getItem('musicVolume');
    audio.volume = savedVolume === null ? 0.7 : Number(savedVolume) / 100;
    volume.value = Math.round(audio.volume * 100);

    function formatTime(seconds) {
        if (!isFinite(seconds)) return '00:00';
        var minutes = Math.floor(seconds / 60);
        var rest = Math.floor(seconds % 60);
        return String(minutes).padStart(2, '0') + ':' + String(rest).padStart(2, '0');
    }
    function effectiveDuration() {
        if (Number.isFinite(audio.duration) && audio.duration > 0) {
            return audio.duration;
        }
        var trackDuration = Number(playlist[currentIndex] &&
                                   playlist[currentIndex].duration || 0);
        if (trackDuration > 0) return trackDuration;
        if (audio.seekable && audio.seekable.length) {
            var seekableEnd = audio.seekable.end(audio.seekable.length - 1);
            if (Number.isFinite(seekableEnd) && seekableEnd > 0) return seekableEnd;
        }
        return 0;
    }
    function syncPlayingState() {
        toggle.classList.toggle('playing', !audio.paused);
        toggle.setAttribute('aria-label', audio.paused ? '播放背景音乐' : '暂停背景音乐');
        disc.classList.toggle('spinning', !audio.paused);
    }

    function readMusicState() {
        try { return JSON.parse(sessionStorage.getItem('rxMusicState') || '{}'); }
        catch (error) { return {}; }
    }

    function saveMusicState(timeOverride) {
        var track = playlist[currentIndex] || defaultTrack;
        var savedTime = typeof timeOverride === 'number' ?
                        timeOverride : (audio.currentTime || 0);
        sessionStorage.setItem('rxMusicState', JSON.stringify({
            source: playlistSource, index: currentIndex,
            trackKey: track.key || String(track.id),
            time: savedTime,
            volume: audio.volume,
            playing: localStorage.getItem('musicPlaying') === '1'
        }));
    }

    function describeTrack(track) {
        return track.artist ? track.title + ' · ' + track.artist : track.title;
    }

    function loadTrack(index, resumeTime) {
        if (!playlist.length) playlist = [defaultTrack];
        currentIndex = (index + playlist.length) % playlist.length;
        var track = playlist[currentIndex];
        pendingTime = Number(resumeTime || 0);
        title.textContent = describeTrack(track);
        disc.style.backgroundImage = track.cover ? 'url("' + track.cover.replace(/"/g, '') + '")' : '';
        disc.classList.toggle('has-cover', Boolean(track.cover));
        if (audio.dataset.trackKey === (track.key || String(track.id)) &&
                audio.currentSrc) {
            pendingTime = 0;
            saveMusicState();
            return;
        }
        audio.dataset.trackKey = track.key || String(track.id);
        audio.src = track.audio;
        audio.load();
        saveMusicState(pendingTime);
    }

    function tryResumePlayback() {
        if (localStorage.getItem('musicPlaying') !== '1') return;
        audio.play().then(syncPlayingState).catch(function() {
            title.textContent = '点击播放 · ' + describeTrack(playlist[currentIndex]);
        });
    }

    function applyMusicContext(data) {
        playlist = data.playlist && data.playlist.length ? data.playlist : [defaultTrack];
        playlistSource = data.source || 'default';
        audio.loop = playlist.length === 1;
        failedTracks = 0;
        var state = readMusicState();
        var sameSource = state.source === playlistSource;
        var keyIndex = playlist.findIndex(function(track) {
            return (track.key || String(track.id)) === state.trackKey;
        });
        // A post and a profile can reference the same track, but they are
        // different playback contexts. Only resume a track inside its source.
        var sameTrack = sameSource && keyIndex >= 0;
        var index = sameTrack ? keyIndex :
                    (sameSource && Number(state.index) < playlist.length ?
                     Number(state.index) : 0);
        loadTrack(index, sameTrack ? state.time : 0);
    }

    toggle.addEventListener('click', function() {
        if (audio.paused) {
            audio.play().then(function() {
                localStorage.setItem('musicPlaying', '1');
                syncPlayingState();
            }).catch(function() { title.textContent = '请再次点击播放'; });
        } else {
            audio.pause();
            localStorage.setItem('musicPlaying', '0');
            syncPlayingState();
        }
    });
    previous.addEventListener('click', function() {
        var shouldPlay = !audio.paused || localStorage.getItem('musicPlaying') === '1';
        loadTrack(currentIndex - 1, 0);
        if (shouldPlay) audio.addEventListener('canplay', tryResumePlayback, {once: true});
    });
    next.addEventListener('click', function() {
        var shouldPlay = !audio.paused || localStorage.getItem('musicPlaying') === '1';
        loadTrack(currentIndex + 1, 0);
        if (shouldPlay) audio.addEventListener('canplay', tryResumePlayback, {once: true});
    });
    audio.addEventListener('loadedmetadata', function() {
        var duration = effectiveDuration();
        if (pendingTime > 0 && duration && pendingTime < duration) audio.currentTime = pendingTime;
        pendingTime = 0;
        tryResumePlayback();
    });
    audio.addEventListener('timeupdate', function() {
        var duration = effectiveDuration();
        if (duration) progress.value = Math.min(100, audio.currentTime / duration * 100);
        time.textContent = formatTime(audio.currentTime);
        saveMusicState();
    });
    progress.addEventListener('input', function() {
        var duration = effectiveDuration();
        if (duration) audio.currentTime = Number(progress.value) / 100 * duration;
    });
    volume.addEventListener('input', function() {
        audio.volume = Number(volume.value) / 100;
        localStorage.setItem('musicVolume', volume.value);
    });
    audio.addEventListener('play', syncPlayingState);
    audio.addEventListener('pause', syncPlayingState);
    audio.addEventListener('ended', function() {
        if (playlist.length === 1) {
            audio.currentTime = 0;
            audio.play().catch(function() {});
        } else {
            loadTrack(currentIndex + 1, 0);
        }
    });
    audio.addEventListener('error', function() {
        failedTracks += 1;
        if (failedTracks < playlist.length) {
            loadTrack(currentIndex + 1, 0);
        } else if (playlistSource !== 'default') {
            playlist = [defaultTrack];
            playlistSource = 'default';
            failedTracks = 0;
            loadTrack(0, 0);
        } else {
            title.textContent = '音乐文件不可用';
        }
    });
    window.addEventListener('pagehide', saveMusicState);

    var musicBrowseProfileUserId = '';
    function readMusicBrowseContext() {
        try { return JSON.parse(sessionStorage.getItem('rxMusicBrowseContext') || '{}'); }
        catch (error) { return {}; }
    }
    function saveMusicBrowseContext(path, pageKind) {
        sessionStorage.setItem('rxMusicBrowseContext', JSON.stringify({
            profileUserId: musicBrowseProfileUserId,
            path: path,
            pageKind: pageKind
        }));
    }
    function referrerProfileUserId() {
        if (!document.referrer) return '';
        try {
            var referrer = new URL(document.referrer);
            if (referrer.origin !== window.location.origin) return '';
            var match = referrer.pathname.match(/^\/user\/(\d+)\/?$/);
            return match ? match[1] : '';
        } catch (error) { return ''; }
    }
    function selectMusicBrowseContext(pagePlayer, path, initialLoad) {
        var profileUserId = pagePlayer.dataset.profileUserId || '';
        var postAuthorId = pagePlayer.dataset.postAuthorId || '';
        var pageKind = profileUserId ? 'profile' :
                       (postAuthorId ? 'post' : 'public');

        if (profileUserId) {
            musicBrowseProfileUserId = profileUserId;
        } else if (postAuthorId) {
            if (initialLoad) {
                var saved = readMusicBrowseContext();
                var cameFromMatchingProfile =
                    String(saved.profileUserId || '') === postAuthorId &&
                    (saved.path === path ||
                     referrerProfileUserId() === postAuthorId);
                musicBrowseProfileUserId = cameFromMatchingProfile ?
                                           postAuthorId : '';
            } else if (musicBrowseProfileUserId !== postAuthorId) {
                musicBrowseProfileUserId = '';
            }
        } else {
            musicBrowseProfileUserId = '';
        }
        saveMusicBrowseContext(path, pageKind);
    }

    var musicContextSequence = 0;
    function refreshMusicContext() {
        var requestSequence = ++musicContextSequence;
        var contextUrl = "/api/music/context";
        if (musicBrowseProfileUserId) {
            contextUrl += '?profile_user_id=' +
                          encodeURIComponent(musicBrowseProfileUserId);
        }
        return fetch(contextUrl, {credentials: 'same-origin'}).then(function(response) {
            if (!response.ok) throw new Error('music context failed');
            return response.json();
        }).then(function(data) {
            if (requestSequence === musicContextSequence) applyMusicContext(data);
        }).catch(function() {
            if (requestSequence === musicContextSequence) {
                applyMusicContext({source: 'default', playlist: [defaultTrack]});
            }
        });
    }

    function initializeProfileContrast() {
        var hero = document.querySelector('.profile-hero[data-background-url]');
        if (!hero) return;
        var image = new Image();
        image.onload = function() {
            try {
                var canvas = document.createElement('canvas');
                var size = 32;
                canvas.width = size;
                canvas.height = size;
                var context = canvas.getContext('2d', {willReadFrequently: true});
                context.drawImage(image, 0, 0, size, size);
                var pixels = context.getImageData(0, 0, size, size).data;
                var luminance = 0;
                var samples = 0;
                for (var i = 0; i < pixels.length; i += 16) {
                    luminance += (pixels[i] * 0.299 + pixels[i + 1] * 0.587 + pixels[i + 2] * 0.114);
                    samples += 1;
                }
                var useLightText = samples && luminance / samples < 145;
                hero.classList.toggle('profile-text-light', useLightText);
                hero.classList.toggle('profile-text-dark', !useLightText);
            } catch (error) {
                hero.classList.add('profile-text-dark');
            }
        };
        image.src = hero.dataset.backgroundUrl;
    }

    function closeLightbox() {
        var lightbox = document.getElementById('imageLightbox');
        if (lightbox) lightbox.hidden = true;
    }

    function initializeVideoCoverPreviews() {
        document.querySelectorAll('video.video-cover-preview').forEach(function(video) {
            if (video.dataset.previewInitialized === 'true') return;
            video.dataset.previewInitialized = 'true';
            function freezeArticleCover() {
                if (!video.classList.contains('article-cover-video') ||
                        !video.videoWidth || !video.videoHeight) return;
                try {
                    var scale = Math.min(1, 1280 / video.videoWidth);
                    var canvas = document.createElement('canvas');
                    canvas.width = Math.round(video.videoWidth * scale);
                    canvas.height = Math.round(video.videoHeight * scale);
                    canvas.getContext('2d').drawImage(
                        video, 0, 0, canvas.width, canvas.height);
                    var image = document.createElement('img');
                    image.className = 'article-cover-video frozen-video-cover';
                    image.alt = video.getAttribute('aria-label') || '视频封面';
                    image.src = canvas.toDataURL('image/jpeg', 0.84);
                    video.pause();
                    video.removeAttribute('src');
                    video.load();
                    video.replaceWith(image);
                } catch (error) {
                    video.pause();
                }
            }
            function showFirstFrame() {
                if (!Number.isFinite(video.duration) || video.duration <= 0) return;
                video.currentTime = Math.min(0.1, video.duration / 2);
                video.pause();
                if (video.classList.contains('article-cover-video')) {
                    if (video.readyState >= 2) freezeArticleCover();
                    else video.addEventListener('loadeddata', freezeArticleCover,
                                                {once: true});
                    video.addEventListener('seeked', freezeArticleCover,
                                           {once: true});
                }
            }
            if (video.readyState >= 1) showFirstFrame();
            else video.addEventListener('loadedmetadata', showFirstFrame, {once: true});
        });
    }

    function initializeVideoPlaybackErrors() {
        document.querySelectorAll('.post-video-item').forEach(function(item) {
            var video = item.querySelector('video.post-video');
            var message = item.querySelector('.video-playback-error');
            if (!video || !message || video.dataset.errorInitialized === 'true') return;
            video.dataset.errorInitialized = 'true';
            function showError() { message.hidden = false; }
            function hideError() { message.hidden = true; }
            video.addEventListener('error', showError);
            video.addEventListener('canplay', hideError);
            if (video.error) showError();
        });
    }

    function initializePostVideos() {
        document.querySelectorAll('video.post-video').forEach(function(video) {
            if (video.dataset.playbackInitialized === 'true') return;
            video.dataset.playbackInitialized = 'true';

            video.addEventListener('play', function() {
                document.querySelectorAll('video.post-video').forEach(function(other) {
                    if (other !== video) other.pause();
                });
                if (!audio.paused) {
                    audio.pause();
                    localStorage.setItem('musicPlaying', '0');
                    saveMusicState();
                    syncPlayingState();
                }
            });

            video.addEventListener('ended', function() {
                video.pause();
                video.currentTime = 0;
            });
        });
    }

    function initializePostImageUpload() {
        document.querySelectorAll('input.js-post-images').forEach(function(input) {
            if (input.dataset.uploadInitialized === 'true') return;
            input.dataset.uploadInitialized = 'true';

            var group = input.closest('.form-group');
            var status = group && group.querySelector('.post-image-selection-status');
            var preview = group && group.querySelector('.post-image-preview');
            var maxImages = Number(input.dataset.maxImages || 9);
            var selectedFiles = Array.from(input.files || []);
            var previewUrls = [];

            function fileKey(file) {
                return [file.name, file.size, file.lastModified].join(':');
            }

            function updateInputFiles() {
                if (typeof DataTransfer === 'undefined') return false;
                try {
                    var transfer = new DataTransfer();
                    selectedFiles.forEach(function(file) { transfer.items.add(file); });
                    input.files = transfer.files;
                    return true;
                } catch (error) {
                    return false;
                }
            }

            function renderSelection(message, isError) {
                previewUrls.forEach(function(url) { URL.revokeObjectURL(url); });
                previewUrls = [];
                if (status) {
                    status.textContent = message || (selectedFiles.length
                        ? '已选择 ' + selectedFiles.length + ' 张图片，可继续点击上方控件追加。'
                        : '尚未选择新图片');
                    status.classList.toggle('has-error', Boolean(isError));
                }
                if (!preview) return;
                preview.innerHTML = '';
                selectedFiles.forEach(function(file, index) {
                    var item = document.createElement('div');
                    item.className = 'post-image-preview-item';
                    var image = document.createElement('img');
                    var url = URL.createObjectURL(file);
                    previewUrls.push(url);
                    image.src = url;
                    image.alt = file.name;
                    var remove = document.createElement('button');
                    remove.type = 'button';
                    remove.className = 'post-image-preview-remove';
                    remove.dataset.index = String(index);
                    remove.setAttribute('aria-label', '移除 ' + file.name);
                    remove.textContent = '×';
                    item.appendChild(image);
                    item.appendChild(remove);
                    preview.appendChild(item);
                });
            }

            input.addEventListener('change', function() {
                var additions = Array.from(input.files || []);
                var known = new Set(selectedFiles.map(fileKey));
                additions.forEach(function(file) {
                    var key = fileKey(file);
                    if (!known.has(key)) {
                        selectedFiles.push(file);
                        known.add(key);
                    }
                });
                if (selectedFiles.length > maxImages) {
                    selectedFiles = selectedFiles.slice(0, maxImages);
                    if (!updateInputFiles()) selectedFiles = additions.slice(0, maxImages);
                    renderSelection('每篇博文最多选择 ' + maxImages + ' 张图片，多出的图片未加入。', true);
                    return;
                }
                if (!updateInputFiles()) selectedFiles = additions;
                renderSelection();
            });

            if (preview) preview.addEventListener('click', function(event) {
                var button = event.target.closest('.post-image-preview-remove');
                if (!button) return;
                selectedFiles.splice(Number(button.dataset.index), 1);
                updateInputFiles();
                renderSelection();
            });

            renderSelection();
        });
    }

    function initializePageFeatures() {
        initializeProfileContrast();
        initializeVideoCoverPreviews();
        initializeVideoPlaybackErrors();
        initializePostVideos();
        initializePostImageUpload();
        document.dispatchEvent(new CustomEvent('rx:page-ready'));
    }

    document.addEventListener('click', function(event) {
        var thumb = event.target.closest('.gallery-thumb');
        if (thumb) {
            var lightbox = document.getElementById('imageLightbox');
            if (!lightbox) return;
            lightbox.querySelector('img').src = thumb.dataset.full;
            lightbox.hidden = false;
            return;
        }
        var close = event.target.closest('.lightbox-close');
        var overlay = event.target.id === 'imageLightbox';
        if (close || overlay) closeLightbox();
    });
    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape') closeLightbox();
    });

    var pjaxController = null;
    var pjaxSequence = 0;

    function canUsePjax(link, event) {
        if (!link || event.defaultPrevented || event.button !== 0 ||
                event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
        if (link.target && link.target !== '_self') return false;
        if (link.hasAttribute('download') || link.dataset.noPjax !== undefined) return false;
        var url;
        try { url = new URL(link.href, window.location.href); }
        catch (error) { return false; }
        if (url.origin !== window.location.origin || !/^https?:$/.test(url.protocol)) return false;
        if (url.pathname === "/admin/logout") return false;
        if (url.pathname === window.location.pathname &&
                url.search === window.location.search && url.hash) return false;
        return true;
    }

    function updateShellFromDocument(nextDocument, nextUrl) {
        var nextPanel = nextDocument.querySelector('.content-glass-panel');
        var currentPanel = document.querySelector('.content-glass-panel');
        var nextPlayer = nextDocument.getElementById('musicPlayer');
        if (!nextPanel || !currentPanel || !nextPlayer) {
            throw new Error('PJAX response is missing the application shell');
        }

        currentPanel.className = nextPanel.className;
        currentPanel.innerHTML = nextPanel.innerHTML;
        document.title = nextDocument.title;

        var nextCsrf = nextDocument.querySelector('meta[name="csrf-token"]');
        var currentCsrf = document.querySelector('meta[name="csrf-token"]');
        if (nextCsrf && currentCsrf) {
            currentCsrf.content = nextCsrf.content;
            csrfToken = nextCsrf.content;
        }

        player.dataset.profileUserId = nextPlayer.dataset.profileUserId || '';
        player.dataset.postAuthorId = nextPlayer.dataset.postAuthorId || '';
        selectMusicBrowseContext(
            nextPlayer, new URL(nextUrl, window.location.href).pathname, false);

        var nextLinks = nextDocument.querySelectorAll('.sidebar-link');
        var currentLinks = document.querySelectorAll('.sidebar-link');
        currentLinks.forEach(function(link) { link.classList.remove('active'); });
        nextLinks.forEach(function(nextLink) {
            if (!nextLink.classList.contains('active')) return;
            currentLinks.forEach(function(currentLink) {
                if (currentLink.getAttribute('href') === nextLink.getAttribute('href')) {
                    currentLink.classList.add('active');
                }
            });
        });
    }

    function navigatePjax(target, options) {
        options = options || {};
        var url = new URL(target, window.location.href);
        var sequence = ++pjaxSequence;
        if (pjaxController) pjaxController.abort();
        pjaxController = new AbortController();
        body.classList.add('pjax-loading');

        return fetch(url.href, {
            method: 'GET',
            credentials: 'same-origin',
            headers: {'X-PJAX': 'true', 'X-Requested-With': 'XMLHttpRequest'},
            signal: pjaxController.signal
        }).then(function(response) {
            if (!response.ok) throw new Error('navigation failed');
            return response.text().then(function(html) {
                return {html: html, url: response.url};
            });
        }).then(function(result) {
            if (sequence !== pjaxSequence) return;
            var nextDocument = new DOMParser().parseFromString(result.html, 'text/html');
            updateShellFromDocument(nextDocument, result.url);
            if (options.history !== false) history.pushState({pjax: true}, '', result.url);
            if (options.scroll !== false) window.scrollTo({top: 0, behavior: 'auto'});
            setSidebar(false);
            initializePageFeatures();
            refreshMusicContext();
            document.getElementById('content').focus({preventScroll: true});
        }).catch(function(error) {
            if (error.name !== 'AbortError') window.location.assign(url.href);
        }).finally(function() {
            if (sequence === pjaxSequence) body.classList.remove('pjax-loading');
        });
    }

    document.addEventListener('click', function(event) {
        var link = event.target.closest('a[href]');
        if (!canUsePjax(link, event)) return;
        event.preventDefault();
        navigatePjax(link.href);
    });

    document.addEventListener('submit', function(event) {
        var form = event.target;
        if (event.defaultPrevented || form.dataset.noPjax !== undefined) return;
        if ((form.method || 'get').toLowerCase() !== 'get') return;
        if (form.target && form.target !== '_self') return;
        event.preventDefault();
        var url = new URL(form.action || window.location.href, window.location.href);
        new FormData(form).forEach(function(value, key) { url.searchParams.append(key, value); });
        navigatePjax(url.href);
    });

    window.addEventListener('popstate', function() {
        navigatePjax(window.location.href, {history: false, scroll: false});
    });

    selectMusicBrowseContext(player, window.location.pathname, true);
    initializePageFeatures();
    refreshMusicContext();
    syncPlayingState();
})();
</script>


